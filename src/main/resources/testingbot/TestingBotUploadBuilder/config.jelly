<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="App file" field="file">
        <f:textbox/>
    </f:entry>
    <f:entry title="TestingBot Credentials" field="credentialsId">
        <c:select/>
    </f:entry>
    <f:entry title="Environment variable" field="variableName">
        <f:textbox default="TESTINGBOT_APP_URL"/>
    </f:entry>
</j:jelly>
